---
import Hero from "@/components/Hero.astro";
import Sidebar from "@/components/Sidebar.astro";
import { Content as Home } from "@/markdown/home.md";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="flex justify-between p-4">
    <main
      class="grid min-h-screen grid-cols-8 md:grid-cols-12 gap-10 md:gap-20"
    >
      <div class="col-span-8 flex flex-col gap-4">
        <Hero />
        <div class="col-span-8 flex flex-col gap-4">
          <div
            class="prose prose-invert mt-16 max-w-4xl prose-p:text-stone-100 prose-em:text-stone-100 prose-li:text-stone-100 prose-h2:text-lg prose-pre:p-2 prose-pre:-mx-2 prose-pre:backdrop-blur-xl prose-pre:bg-white/10 prose-pre:shadow-inner prose-pre:shadow-black/5 prose-pre:border prose-pre:border-white/10 prose-a:underline prose-a:underline-offset-4 prose-a:decoration-from-font"
          >
            <Home />
          </div>
        </div>
      </div>
      <Sidebar />
    </main>
  </div>
</Layout>
