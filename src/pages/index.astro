---
import Hero from "@/components/Hero.astro";
import Sidebar from "@/components/Sidebar.astro";
import { Content as Home } from "@/markdown/home.md";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="p-4">
    <main
      class="grid min-h-screen grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12 xl:gap-20"
    >
      <div class="col-span-full flex flex-col gap-4 lg:col-span-8">
        <Hero />
        <div class="flex flex-col gap-4">
          <div
            class:list={[
              "prose prose-invert mt-8 max-w-4xl prose-h2:text-lg prose-pre:max-w-full prose-pre:overflow-x-auto prose-pre:p-2 prose-pre:-mx-2 prose-pre:backdrop-blur-xl prose-pre:bg-white/10 prose-pre:shadow-inner prose-pre:shadow-black/5 prose-pre:border prose-pre:border-white/10 prose-a:text-blue-400 prose-a:underline prose-a:underline-offset-4 prose-a:decoration-from-font hover:prose-a:text-blue-300",
            ]}
          >
            <Home />
          </div>
        </div>
      </div>
      <Sidebar />
    </main>
  </div>
</Layout>
