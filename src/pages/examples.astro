---
import Sidebar from "@/components/Sidebar.astro";
import Markdown from "@/components/Markdown.astro";
import { Content as Examples } from "@/markdown/examples.md";
import Layout from "@/layouts/Layout.astro";

const sections = [
  { href: "#start-here", label: "Start here" },
  { href: "#layout-and-styling", label: "Layout and styling" },
  { href: "#desktop-app-patterns", label: "Desktop app patterns" },
  { href: "#accessibility-and-testing", label: "Accessibility and testing" },
  { href: "#more-examples", label: "More examples" },
];
---

<Layout
  title="GPUI — Examples"
  description="Practical GPUI patterns for Rust UI and desktop apps."
>
  <div class="p-4">
    <main
      class="grid min-h-screen grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12 xl:gap-20"
    >
      <nav
        aria-label="Examples on this page"
        class="col-span-full flex flex-wrap items-center gap-x-4 gap-y-2 self-start border-t border-white/15 pt-3 text-xs lg:sticky lg:top-8 lg:col-span-2 lg:flex-col lg:flex-nowrap lg:items-start lg:gap-3 lg:border-l lg:border-t-0 lg:pl-4 lg:pt-0 lg:text-sm"
      >
        <span class="text-xs text-stone-400">On this page</span>
        {
          sections.map((section) => (
            <a
              href={section.href}
              class="site-link opacity-80 transition-opacity hover:opacity-100"
            >
              {section.label}
            </a>
          ))
        }
      </nav>
      <article class="col-span-full max-w-3xl lg:col-span-6">
        <Markdown>
          <Examples />
        </Markdown>
      </article>
      <Sidebar className="lg:!col-span-4" />
    </main>
  </div>
</Layout>
