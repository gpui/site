---
import Sidebar from "@/components/Sidebar.astro";
import Markdown from "@/components/Markdown.astro";
import { Content as Examples } from "@/markdown/examples.md";
import Layout from "@/layouts/Layout.astro";

const sections = [
  { href: "#start-here", label: "Start here" },
  { href: "#layout-and-styling", label: "Layout and styling" },
  { href: "#desktop-app-patterns", label: "Desktop app patterns" },
  { href: "#accessibility-and-testing", label: "Accessibility and testing" },
  { href: "#more-examples", label: "More examples" },
];
---

<Layout
  title="gpui — Examples"
  description="Practical GPUI patterns for Rust UI and desktop apps."
>
  <div class="flex justify-between p-4">
    <main
      class="grid min-h-screen grid-cols-1 gap-10 md:grid-cols-12 md:gap-20"
    >
      <nav
        aria-label="Examples on this page"
        class="col-span-2 flex shrink-0 flex-col gap-3 self-start border-l border-white/15 pl-4 text-sm md:sticky md:top-8 md:w-48"
      >
        <span class="text-xs text-stone-400">On this page</span>
        {
          sections.map((section) => (
            <a
              href={section.href}
              class="site-link opacity-80 transition-opacity hover:opacity-100"
            >
              {section.label}
            </a>
          ))
        }
      </nav>
      <article class="md:col-span-6 max-w-3xl">
        <Markdown>
          <Examples />
        </Markdown>
      </article>
      <Sidebar className="!col-span-4" />
    </main>
  </div>
</Layout>
